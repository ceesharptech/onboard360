PORT=5000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME"
JWT_ACCESS_SECRET="your-super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"
ASSISTANT_SIMILARITY_THRESHOLD="0.50"

# Rate Limiting Escape Hatch (Local Development Only)
# Set to "true" to disable loginLimiter and generalLimiter during manual multi-role testing.
# WARNING: MUST NEVER be set to "true" in any deployed or production environment!
DISABLE_RATE_LIMITING="false"

